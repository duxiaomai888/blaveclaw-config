# Blave API Configuration
# 复制本文件为 .env 并填入你的 API key
# lib/data.py 的 _KeyRotator 会自动读取 blave_api_key[N] (N=1..10)

# Primary key (必需)
blave_api_key=YOUR_KEY_HERE
blave_secret_key=YOUR_SECRET_HERE

# Backup keys (可选, 用于请求限流轮询, 推荐 4-6 个)
blave_api_key2=
blave_secret_key2=
blave_api_key3=
blave_secret_key3=
blave_api_key4=
blave_secret_key4=
blave_api_key5=
blave_secret_key5=
blave_api_key6=
blave_secret_key6=

# ── 交易所 API (实盘部署用, 测试阶段不需要) ──
BITMART_API_KEY=
BITMART_API_SECRET=
BITMART_API_MEMO=

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# ... 详见 skills/blave-quant/SKILL.md
