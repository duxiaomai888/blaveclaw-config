# Blave API Configuration
# 复制本文件为 .env 并填入你的 API key
# lib/data/http.py 自动读取 blave_api_key / blave_secret_key 及 _2.._20
# (最多 20 对;每对是独立的按 IP 限流额度,_retry_get 逐请求轮询)
# 安全限速 = 1.67 req/s/key(= 服务器 500/5min 硬上限;实测验证非保守值:
# 2026-09-14 单 key 冷启扫描 1.67 持续 172s/284 req 零 429,2.0 在第 221 req
# (110s)触发 429。)

# Primary key (必需)
blave_api_key=YOUR_KEY_HERE
blave_secret_key=YOUR_SECRET_HERE

# Backup keys (可选, 用于请求限流轮询, 最多 19 个)
blave_api_key2=
blave_secret_key2=
blave_api_key3=
blave_secret_key3=
blave_api_key4=
blave_secret_key4=
blave_api_key5=
blave_secret_key5=
blave_api_key6=
blave_secret_key6=
blave_api_key7=
blave_secret_key7=
blave_api_key8=
blave_secret_key8=

blave_api_key9=
blave_secret_key9=
blave_api_key10=
blave_secret_key10=
blave_api_key11=
blave_secret_key11=
blave_api_key12=
blave_secret_key12=
blave_api_key13=
blave_secret_key13=
blave_api_key14=
blave_secret_key14=
blave_api_key15=
blave_secret_key15=
blave_api_key16=
blave_secret_key16=
blave_api_key17=
blave_secret_key17=
blave_api_key18=
blave_secret_key18=
blave_api_key19=
blave_secret_key19=
blave_api_key20=
blave_secret_key20=

# ── 交易所 API (实盘部署用, 测试阶段不需要) ──
BITMART_API_KEY=
BITMART_API_SECRET=
BITMART_API_MEMO=

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

BYBIT_API_KEY=
BYBIT_API_SECRET=

